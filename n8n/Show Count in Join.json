    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\nconst today = $now\n  .setZone('Europe/Berlin')\n  .toFormat('yyyy-MM-dd');\n\nconst row = rows.find(item => {\n  if (!item.date) return false;\n\n  return String(item.date).slice(0, 10) === today;\n});\n\nconst limit = 10;\n\nconst used = Math.min(\n  Math.max(Number(row?.used ?? 0), 0),\n  limit\n);\n\nreturn [{\n  json: {\n    used,\n    limit,\n    remaining: limit - used\n  }\n}];\n"
      },
